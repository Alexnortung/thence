{
	"name": "thence",
	"version": "0.0.0",
	"description": "Reactive derived values for programs built at runtime",
	"keywords": [],
	"homepage": "https://alexnortung.github.io/thence/",
	"bugs": {
		"url": "https://github.com/Alexnortung/thence/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Alexnortung/thence.git"
	},
	"license": "MIT",
	"author": "Alexander Nortung",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./react": {
			"import": {
				"types": "./dist/react/index.d.mts",
				"default": "./dist/react/index.mjs"
			},
			"require": {
				"types": "./dist/react/index.d.cts",
				"default": "./dist/react/index.cjs"
			}
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"docs:build": "deno doc --html --name=thence --output=docs-dist src/index.ts",
		"format": "biome format --fix && prettier --write \"**/*.{yml,yaml}\"",
		"knip": "knip",
		"lint": "biome check --fix",
		"lint:package": "publint",
		"prepare": "lefthook install",
		"prepublishOnly": "pnpm run build",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:demos": "playwright test",
		"typecheck": "tsc --noEmit && tsc -p examples"
	},
	"dependencies": {
		"type-fest": "^5.10.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@playwright/test": "^1.63.0",
		"@types/node": "^26.6.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^5.0.2",
		"deno": "2.9.6",
		"happy-dom": "^20.14.5",
		"knip": "^6.38.0",
		"lefthook": "^2.1.14",
		"lint-staged": "^17.5.1",
		"pkg-pr-new": "^0.0.88",
		"prettier": "^3.9.9",
		"publint": "^0.3.24",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.2"
	},
	"peerDependencies": {
		"react": ">=18"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.6.0",
			"onFail": "download"
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
