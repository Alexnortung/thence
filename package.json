{
	"name": "ts-library-starter",
	"version": "0.0.0",
	"description": "",
	"keywords": [],
	"homepage": "https://alexnortung.github.io/ts-library-starter/",
	"bugs": {
		"url": "https://github.com/Alexnortung/ts-library-starter/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Alexnortung/ts-library-starter.git"
	},
	"license": "MIT",
	"author": "Alexander Nortung",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"docs:build": "deno doc --html --name=ts-library-starter --output=docs-dist src/index.ts",
		"format": "biome format --fix && prettier --write \"**/*.{yml,yaml}\"",
		"knip": "knip",
		"lint": "biome check --fix",
		"lint:package": "publint",
		"prepare": "lefthook install",
		"prepublishOnly": "pnpm run build",
		"spike:determinism": "cd spikes/determinism && node run.mjs",
		"spike:determinism:check": "esbuild spikes/determinism/src/check.ts --bundle --platform=node --format=esm --outfile=spikes/determinism/dist/check.mjs --log-level=warning && node spikes/determinism/dist/check.mjs",
		"spike:types": "tsc -p spikes/types",
		"spike:types:scale": "node spikes/types/scale/gen.mjs && tsc -p spikes/types/scale --extendedDiagnostics",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/node": "^26.6.3",
		"@vitest/coverage-v8": "^5.0.2",
		"deno": "2.9.6",
		"esbuild": "^0.28.2",
		"knip": "^6.38.0",
		"lefthook": "^2.1.14",
		"lint-staged": "^17.5.1",
		"pkg-pr-new": "^0.0.88",
		"playwright": "1.56.1",
		"prettier": "^3.9.9",
		"publint": "^0.3.24",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.2"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.6.0",
			"onFail": "download"
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
